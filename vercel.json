{
  "redirects": [
    { "source": "/proyectos", "destination": "/web?grupo=propios", "permanent": true },
    { "source": "/proyectos/:slug", "destination": "/web/:slug", "permanent": true },
    { "source": "/profesional", "destination": "/web?grupo=produccion", "permanent": true },
    { "source": "/profesional/:slug", "destination": "/web/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
